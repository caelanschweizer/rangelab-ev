# Docker Compose publishes to loopback because the API is unauthenticated.
# Do not change this to 0.0.0.0 without an authenticated TLS gateway and data
# lifecycle controls.
RANGELAB_BIND_HOST=127.0.0.1

# Docker Compose ports
RANGELAB_WEB_PORT=3000
RANGELAB_API_PORT=8000

# Local PostgreSQL container. Change these for any non-local environment.
RANGELAB_DB_NAME=rangelab
RANGELAB_DB_USER=rangelab
RANGELAB_DB_PASSWORD=local-development-only

# API configuration
# Native development can instead keep the SQLite default:
# RANGELAB_DATABASE_URL=sqlite:///./rangelab.db
RANGELAB_CORS_ORIGINS=http://localhost:3000
RANGELAB_MAX_UPLOAD_BYTES=10000000
RANGELAB_TRIP_GAP_MINUTES=15

# Keys the internal import-identity HMAC. Use a high-entropy value containing at
# least 32 UTF-8 bytes, keep it stable for an existing database, and do not
# commit a real value. Rotation changes request identities and invalidates
# existing idempotency-key matches.
RANGELAB_IDENTITY_SECRET=replace-with-at-least-32-random-bytes
