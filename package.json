{
  "name": "rangelab-ev",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "pnpm run build && node --test tests/*.test.mjs",
    "test:unit": "node --test tests/*.test.mjs",
    "test:backend": "cd backend && python -m pytest",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.56.0",
    "@eslint/js": "9.39.5",
    "@next/eslint-plugin-next": "16.3.5",
    "@openai/sites-vite-plugin": "0.2.0",
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.35",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.5.0",
    "react-server-dom-webpack": "19.3.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vinext": "1.0.0-beta.2",
    "vite": "8.3.0",
    "wrangler": "4.135.0"
  },
  "type": "module"
}
